# Copy this file to ".env" and fill it in. NEVER share or commit ".env".

# ---- Supplier logins (no quotes needed) ----
BEEHIVE_USERNAME=
BEEHIVE_PASSWORD=
BIRLEA_USERNAME=
BIRLEA_PASSWORD=
HEARTLANDS_USERNAME=
HEARTLANDS_PASSWORD=
JULIAN_BOWEN_USERNAME=
JULIAN_BOWEN_PASSWORD=
FLAIR_USERNAME=
FLAIR_PASSWORD=

# ---- Output ----
EXCEL_PATH=C:\Users\USER1\Desktop\WebScraping\Supplier Data.xlsx

# ---- Browser ----
# false = you see Chrome open (best for testing / solving captchas)
HEADLESS=false
# seconds to wait between page loads (be polite to the supplier sites)
PAGE_DELAY=2
# safety cap on pages visited per supplier
MAX_PAGES=20000
# write to Excel after every N products (1 = instantly)
SAVE_EVERY=1

# ---- Shopify (STEP 1 list + STEP 2 sync) ----
SHOPIFY_STORE=
# the access token is fetched with these and kept in 'access token.txt'
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_PRODUCT_STATUS=DRAFT
SHOPIFY_BATCH_SIZE=20
# safety switches: STEP 2 stock/price updates, supplier collections
SHOPIFY_ALLOW_SYNC=false
SHOPIFY_CREATE_COLLECTIONS=false
# empty = the store's first location
SHOPIFY_LOCATION_ID=

# ---- Prices: Shopify price = supplier price + MARGIN% + fee, rounded UP to ...9.99 (46.56 -> 49.99) ----
PRICE_MARGIN_PERCENT=20
PRICE_FEE_STANDARD=35
# fee for sofas / big items:
PRICE_FEE_BIG=85
# words in the title/category that make a product "big" (comma separated):
BIG_ITEM_KEYWORDS=sofa,settee,chaise,corner sofa,corner group,sofa bed,recliner sofa
# also "big" when it weighs at least this many kg (0 = off):
BIG_ITEM_MIN_WEIGHT_KG=0
PRICE_ROUND_TO_9_99=true

# ---- Stock rules ----
# quantity when the supplier only says "in stock"
STOCK_IN_STOCK_QTY=5
# subtracted from a real stock number
STOCK_BUFFER=0
# daily runs a product may be missing before its stock is set to 0
MISSING_RUNS_BEFORE_ZERO=2
