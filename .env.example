# Copy this file to ".env" and fill it in. NEVER share or commit ".env".

# ---- Supplier logins (no quotes needed) ----
BEEHIVE_USERNAME=
BEEHIVE_PASSWORD=
# Beehive Stock Feed API key (portal > Resources > Stock Feed): exact stock + RRP + specs
BEEHIVE_STOCK_TOKEN=
BIRLEA_USERNAME=
BIRLEA_PASSWORD=
JULIAN_BOWEN_USERNAME=
JULIAN_BOWEN_PASSWORD=
FLAIR_USERNAME=
FLAIR_PASSWORD=

# ---- Output ----
EXCEL_PATH=C:\Users\USER1\Desktop\WebScraping\Supplier Data.xlsx

# ---- Browser ----
# false = you see Chrome open (best for testing / solving captchas)
HEADLESS=false
# seconds to wait between page loads (be polite to the supplier sites)
PAGE_DELAY=2
# safety cap on pages visited per supplier
MAX_PAGES=20000
# write to Excel after every N products (1 = instantly)
SAVE_EVERY=1

# ---- Shopify (STEP 1 list + STEP 2 sync) ----
SHOPIFY_STORE=
# the access token is fetched with these and kept in 'access token.txt'
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_LISTING_STATUS=ACTIVE
# ACTIVE products are published to these sales channels (needs read_publications + write_publications scopes)
# names as in Shopify, comma separated, e.g. Online Store,Shop,Google & YouTube  - or: all
SHOPIFY_PUBLISH_CHANNELS=Online Store
SHOPIFY_BATCH_SIZE=20
# safety switches: STEP 2 stock/price updates, supplier collections
SHOPIFY_ALLOW_SYNC=false
SHOPIFY_CREATE_COLLECTIONS=false
# empty = the store's first location
SHOPIFY_LOCATION_ID=

# ---- Prices: X = supplier price ----
# Shopify price = (X + VAT% + delivery charge) + PROFIT_MARGIN%, rounded UP to ...9.99
# e.g. X=100, small item: 100 + 20 = 120; + 40 delivery = 160; + 35% = 216 -> 219.99
PRICE_VAT_PERCENT=20
PROFIT_MARGIN_PERCENT=35
# total = margin on (X + VAT + delivery);  supplier_price = margin on X only (100+20+40+35 = 195 -> 199.99)
PRICE_MARGIN_ON=total
PRICE_ROUND_TO_9_99=true
# delivery charge 40 (small) ... 80 (big)
DELIVERY_MIN=40
DELIVERY_MEDIUM=60
DELIVERY_MAX=80
# by weight: up to 15 kg = 40, up to 25 kg = 50, up to 35 kg = 60, up to 50 kg = 70, heavier = DELIVERY_MAX
DELIVERY_WEIGHT_STEPS=15:40,25:50,35:60,50:70
# always DELIVERY_MAX (words in title / category):
BIG_DELIVERY_KEYWORDS=sofa,settee,chaise,corner group,recliner,bed,bedstead,ottoman bed,bunk,sleeper,daybed,day bed,wardrobe,mattress,dining set,bedroom set,sofabed
# never "big" even if they contain a big word:
NOT_BIG_KEYWORDS=bedside,bed side,bedding,bed rail,bench,headboard only
# no weight known: these get DELIVERY_MEDIUM, everything else DELIVERY_MIN
MEDIUM_ITEM_KEYWORDS=sideboard,chest,drawer,dining table,tv unit,tv stand,media unit,bookcase,desk,cabinet,dresser,dressing table,display,shoe,storage unit,console,coffee table,armchair,chair,ottoman,blanket box,trunk,bench

# ---- Stock rules ----
# quantity when the supplier only says "in stock"
STOCK_IN_STOCK_QTY=5
# subtracted from a real stock number
STOCK_BUFFER=0
# daily runs a product may be missing before its stock is set to 0
MISSING_RUNS_BEFORE_ZERO=2

# GFW (public Salsify catalogue, no login). Supplier price used: standard (default) or direct (Direct Fulfilment Price)
GFW_PRICE=standard
